# Application Configuration
APP_NAME="Personal Finance Recommendation System"
ENVIRONMENT=development
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# LLM & Gemma Model Settings (Member 4)
# Keep false unless local weights are available
LLM_ENABLED=false
# Model identifier or local directory path for Gemma 4 E2B or E4B
LLM_MODEL_PATH=
# Path to QLoRA fine-tuned adapter checkpoint (leave empty until trained)
LLM_ADAPTER_PATH=
# Hardware device target: cpu, cuda
LLM_DEVICE=cpu

